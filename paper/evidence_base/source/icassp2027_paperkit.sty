% ICASSP 2027 Paper-Kit-aligned compatibility style.
% Geometry and manuscript structure follow the official ICASSP 2027 Paper Kit
% published by CMS (last updated 01 September 2026): US Letter, 178 x 229 mm
% image area, 86 mm columns, 6 mm column gap, no page numbers, >=9 pt type.
% This file preserves the already validated manuscript layout while matching
% the official published dimensional requirements.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{icassp2027_paperkit}[2026/09/03 ICASSP 2027 Paper-Kit-aligned layout]
\renewcommand{\rmdefault}{ptm}
\renewcommand{\sfdefault}{phv}
\renewcommand{\ttdefault}{pcr}
\setlength{\oddsidemargin}{-6.2mm}
\setlength{\evensidemargin}{-6.2mm}
\setlength{\topmargin}{0pt}
\setlength{\headheight}{0pt}
\setlength{\headsep}{0pt}
\setlength{\textheight}{229mm}
\setlength{\textwidth}{178mm}
\setlength{\columnsep}{6mm}
\pagestyle{empty}
\def\ninept{\def\baselinestretch{.95}\let\normalsize\small\normalsize}
\twocolumn
\flushbottom
\emergencystretch=11pt
\makeatletter
\def\name#1{\gdef\@name{{\em #1}\\}}
\def\address#1{\gdef\@address{#1}}
\gdef\@name{}
\gdef\@address{}
\renewcommand{\title}[1]{\gdef\@title{\uppercase{#1}}}
\renewcommand{\maketitle}{%
  \twocolumn[{\vspace*{1.8em}\begin{center}
  {\large\bfseries\@title\par}\vspace{1.0em}
  {\normalsize\begin{tabular}[t]{c}\@name\@address\end{tabular}\par}
  \end{center}\vspace{1.0em}}]}
\renewenvironment{abstract}{\begin{center}\bfseries ABSTRACT\end{center}\vspace{-0.5em}}{\par}
\newenvironment{keywords}{\vspace{0.35em}\noindent\textbf{\textit{Index Terms}---}}{\par}
\renewcommand\section{\@startsection{section}{1}{\z@}{1.0ex plus .2ex minus .2ex}{0.55ex}{\centering\bfseries\MakeUppercase}}
\renewcommand\subsection{\@startsection{subsection}{2}{\z@}{0.8ex plus .2ex minus .2ex}{0.35ex}{\bfseries}}
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}{0.5ex}{-0.8em}{\bfseries}}
\renewcommand{\thefootnote}{\fnsymbol{footnote}}
\makeatother
